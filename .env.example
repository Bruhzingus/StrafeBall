# Strafeball — example environment configuration.
#
# Copy the values you need into an uncommitted `.env.local` (already git-ignored). Never commit real
# secrets. Vite only exposes variables prefixed with `VITE_` to the client bundle.

# --- Online server URL (optional; defaults to the built-in config) ---
# VITE_SERVER_URL=ws://localhost:2567

# --- Netcode mode label for local-vs-deployed tests (optional) ---
# VITE_NET_MODE=local
