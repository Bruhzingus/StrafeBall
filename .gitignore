# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
out/
.vite/
.cache/

# EXCEPTION: we commit the prebuilt deploy artifacts so the (throttled 1-vCPU) droplet never has
# to run `npm run build` — it just `git pull`s the already-compiled output. Build locally with
# `npm run deploy:prebuild`, then commit. See the deploy script in DEPLOY.md.
#   - dist/        : Vite client bundle (served as static files off the droplet)
#   - server/dist/ : tsc server output; entry point server/dist/server/src/index.js
!/dist/
!/dist/**
!/server/dist/
!/server/dist/**

# Environment files
.env
.env.local
.env.*.local
sshkey
sshkey.pub

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Temporary files
tmp/
temp/

# TypeScript cache
*.tsbuildinfo

# Optional: local test/build assets
coverage/

# If Babylon or other libraries were accidentally downloaded/copied here
# Keep this ONLY if these are not your actual source files
babylon.js
babylon.max.js
babylon.module.js
babylonjs/
