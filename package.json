{
  "name": "strafeball-architecture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run music:manifest",
    "dev": "vite",
    "dev:online": "node scripts/dev-online.mjs",
    "prebuild": "npm run music:manifest",
    "build": "tsc && vite build",
    "build:live": "npm run build && npm --prefix server run build",
    "music:manifest": "node scripts/generateBattleMusicManifest.mjs",
    "typecheck:all": "npm run typecheck && npm --prefix server run typecheck",
    "verify:live": "npm run music:manifest && npm run typecheck:all && npm run build:live",
    "deploy:prebuild": "npm run verify:live && git add -f dist server/dist",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0",
    "@colyseus/sdk": "^0.17.43",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "music-metadata": "^11.9.0",
    "vitest": "^4.1.9"
  }
}
